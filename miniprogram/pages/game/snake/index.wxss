/* 游戏页：聊天贪吃蛇（伪装为聊天窗口） */
page {
  background: #EDEDED;
  --nav-bg: #F7F7F7;
  --line: #E5E5E5;
  --text: #191919;
  --text-2: #888888;
  --green: #07C160;
  --line-strong: #D6D6D6;    /* 界面边框色 */
  --btn-border: #D0D0D0;     /* 按钮边框色 */
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #EDEDED;
}

/* ---------- 顶部栏 ---------- */
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: var(--nav-bg);
  border-bottom: 2rpx solid var(--line-strong);
}
.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  position: relative;
}

.nav-left {
  display: flex;
  align-items: center;
  min-width: 200rpx;
  height: 72rpx;
}
.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
/* 左上角分数 */
.nav-score {
  display: flex;
  align-items: baseline;
  margin-left: 8rpx;
}
.nav-combo {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #F59E0B;
  font-weight: 600;
}
.nav-score-val {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--green);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.ico-back {
  width: 22rpx; height: 22rpx;
  border-left: 4rpx solid #191919;
  border-bottom: 4rpx solid #191919;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.nav-title {
  position: absolute;
  left: 50%; transform: translateX(-50%);
  max-width: 360rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.nav-title > text:first-child {
  font-size: 34rpx; font-weight: 600; color: var(--text);
  max-width: 360rpx;
}
.nav-sub { font-size: 22rpx; color: var(--text-2); margin-top: 2rpx; }

.nav-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 72rpx;
  padding: 0 8rpx;
}
.nav-more .dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #191919;
}
.nav-hover { opacity: .5; }

/* ---------- 消息区（游戏画布） ---------- */
.msg-area {
  position: relative;
  flex: 1;
  overflow: hidden;
  background: #EDEDED;
  border: 2rpx solid var(--line-strong);   /* 墙体与此外框重合、同色同宽 */
  border-radius: 0;
  margin: 0;
}
.canvas {
  position: absolute;
  left: 0; top: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 1;
}

/* 聊天消息滚动层：浮在画布之上 */
.chat-scroll {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 2;
}
/* 消息从底部堆叠，新消息向下滚动出现 */
.chat-inner {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 100%;
  padding: 16rpx 0;
}

/* 装饰性聊天消息：头像 + 气泡
   对方靠左边缘、自己靠右边缘；字号与头像按微信观感放大，
   透明度低，不干扰游戏画面 */
.msg {
  position: relative;
  width: 100%;
  margin-bottom: 18rpx;
  opacity: .72;
  pointer-events: none;
}
/* 消息行：头像固定贴边（绝对定位，不参与 flex 计算）
   → 左右两侧头像位置完全确定，不会因气泡宽度被挤出屏幕 */
.msg.left  { padding-left: 16rpx;  padding-right: 150rpx; }
.msg.right { padding-right: 16rpx; padding-left: 150rpx; }

.msg-avatar {
  position: absolute;
  top: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line-strong);
  background: #D8D8D8;          /* 图片未加载时也占位可见 */
  display: block;
}
.msg.left  .msg-avatar { left: 16rpx; }
.msg.right .msg-avatar { right: 16rpx; }

.msg-bubble {
  max-width: 100%;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.92);
  border: 1rpx solid rgba(0,0,0,0.06);
  font-size: 30rpx;
  line-height: 1.45;
  color: #191919;
  word-break: break-all;
}
.msg.right .msg-bubble {
  background: rgba(149,236,105,0.6);   /* 己方绿色气泡 */
}
.msg.right .msg-bubble {
  background: rgba(149,236,105,0.6);   /* 己方绿色气泡 */
}

/* 老板键伪装层 */
.boss-layer {
  position: absolute;
  inset: 0;
  background: #EDEDED;
  z-index: 5;
}
.boss-tip {
  position: absolute;
  top: 40%; left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: #B2B2B2;
}

/* 中央提示 */
.hint {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 6;
}
.btn-start {
  min-width: 200rpx;
  height: 84rpx;
  padding: 0 48rpx;
  border-radius: 999rpx;
  background: var(--green);
  color: #FFFFFF;
  font-size: 32rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(7,193,96,0.28);
}
.hint-text { margin-top: 20rpx; font-size: 24rpx; color: var(--text-2); }

/* 红包飘字 */
.packet {
  position: absolute;
  left: 50%; top: 42%;
  transform: translate(-50%, -50%);
  color: #FA5151;
  font-size: 72rpx;
  font-weight: 700;
  text-shadow: 0 4rpx 16rpx rgba(250,81,81,0.35);
  animation: pop 1.2s ease-out;
  pointer-events: none;
  z-index: 7;
}
@keyframes pop {
  0%   { opacity: 0; transform: translate(-50%, -20%) scale(.6); }
  30%  { opacity: 1; transform: translate(-50%, -50%) scale(1.15); }
  100% { opacity: 0; transform: translate(-50%, -110%) scale(1); }
}

/* 轻提示 */
.toast {
  position: absolute;
  left: 50%; bottom: 40rpx;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.62);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  z-index: 8;
}

/* ---------- 底部操作栏：仅十字方向键 ---------- */
.actionbar {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 16rpx 24rpx 10rpx;
  background: #F7F7F7;
  border-top: 2rpx solid var(--line-strong);
  flex-shrink: 0;
}

/* 方向键区域：左右铺满整行 */
.pad { width: 100%; }

.pad-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.pad-row:last-child { margin-bottom: 0; }

.dbtn {
  width: 128rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--btn-border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
/* 同一行内按键之间保留间距（左右键与中间设置键） */
.pad-row .dbtn + .dbtn { margin-left: 20rpx; }

/* 中间设置键：与方向键同尺寸，样式略作区分 */
.dbtn.center { background: #F2F2F2; }
.center-text {
  font-size: 30rpx;
  color: #191919;
  font-weight: 500;
}
.dbtn-hover { background: #E2E2E2; }

/* 方向箭头（纯 CSS） */
.arw { width: 0; height: 0; border: 22rpx solid transparent; }
.arw.up    { border-bottom-color: #191919; margin-top: -12rpx; }
.arw.down  { border-top-color: #191919; margin-bottom: -12rpx; }
.arw.left  { border-right-color: #191919; margin-left: -12rpx; }
.arw.right { border-left-color: #191919; margin-right: -12rpx; }

/* 操作提示：居中，位于方向键下方 */
.bar-hint {
  text-align: center;
  font-size: 20rpx;
  color: #B2B2B2;
  margin-top: 6rpx;
}

/* ---------- 结算弹窗（伪装） ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 200;
}
.dialog {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}
.dlg-title {
  padding: 40rpx 32rpx 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.dlg-body {
  padding: 0 32rpx 36rpx;
  text-align: center;
  font-size: 27rpx;
  color: #4A4A4A;
  line-height: 1.7;
  white-space: pre-line;
}
.dlg-btns {
  display: flex;
  border-top: 1rpx solid var(--line);
}
.dlg-btn {
  flex: 1;
  height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
  color: var(--text);
}
.dlg-btn + .dlg-btn { border-left: 1rpx solid var(--line); }
.dlg-btn.primary { color: var(--green); font-weight: 600; }

.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* ============================================================
 * 暂停态：仿微信聊天输入栏（替换方向键）
 * ============================================================ */
.inputbar {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx 10rpx;
  background: #F7F7F7;
  border-top: 2rpx solid var(--line-strong);
  flex-shrink: 0;
}

.ib-row {
  display: flex;
  align-items: center;
  width: 100%;
}

.ib-ico {
  width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

/* 语音图标：一段圆弧 */
.voice-arc {
  width: 30rpx; height: 30rpx;
  border: 3rpx solid #191919;
  border-radius: 50%;
  border-right-color: transparent;
  border-bottom-color: transparent;
  transform: rotate(-45deg);
}

/* 输入框 */
.ib-input {
  flex: 1;
  height: 68rpx;
  margin: 0 16rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--line-strong);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}
.ib-ph { font-size: 30rpx; color: #B2B2B2; }

/* 表情图标：圆脸 + 两点眼睛 */
.emoji-face {
  width: 32rpx; height: 32rpx;
  border: 3rpx solid #191919;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 5rpx;
}
.emoji-eye {
  width: 4rpx; height: 4rpx;
  border-radius: 50%;
  background: #191919;
}

/* 加号图标：圆环 + 十字 */
.plus-ring {
  width: 32rpx; height: 32rpx;
  border: 3rpx solid #191919;
  border-radius: 50%;
  position: relative;
}
.plus-ring::before, .plus-ring::after {
  content: '';
  position: absolute;
  background: #191919;
  border-radius: 2rpx;
}
.plus-ring::before { left: 6rpx; top: 13rpx; width: 20rpx; height: 3rpx; }
.plus-ring::after  { top: 6rpx; left: 13rpx; height: 20rpx; width: 3rpx; }

.ib-hint {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #B2B2B2;
}
