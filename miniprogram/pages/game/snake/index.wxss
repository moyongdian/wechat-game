/* 游戏页：聊天贪吃蛇（伪装为聊天窗口） */
page {
  background: #EDEDED;
  --nav-bg: #F7F7F7;
  --line: #E5E5E5;
  --text: #191919;
  --text-2: #888888;
  --green: #07C160;
  --line-strong: #D6D6D6;    /* 界面边框色 */
  --btn-border: #D0D0D0;     /* 按钮边框色 */
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #EDEDED;
}

/* ---------- 顶部栏 ---------- */
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: var(--nav-bg);
  border-bottom: 2rpx solid var(--line-strong);
}
.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  position: relative;
}

.nav-left {
  display: flex;
  align-items: center;
  min-width: 200rpx;
  height: 72rpx;
}
.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
/* 左上角分数 */
.nav-score {
  display: flex;
  align-items: baseline;
  margin-left: 8rpx;
}
.nav-score-val {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--green);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.ico-back {
  width: 22rpx; height: 22rpx;
  border-left: 4rpx solid #191919;
  border-bottom: 4rpx solid #191919;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.nav-title {
  position: absolute;
  left: 50%; transform: translateX(-50%);
  max-width: 360rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.nav-title > text:first-child {
  font-size: 34rpx; font-weight: 600; color: var(--text);
  max-width: 360rpx;
}
.nav-sub { font-size: 22rpx; color: var(--text-2); margin-top: 2rpx; }

.nav-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 72rpx;
  padding: 0 8rpx;
}
.nav-more .dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #191919;
}
.nav-hover { opacity: .5; }

/* ---------- 消息区（游戏画布） ---------- */
.msg-area {
  position: relative;
  flex: 1;
  overflow: hidden;
  background: #EDEDED;
  border: 2rpx solid var(--line-strong);
  border-radius: 12rpx;
  margin: 12rpx;
}
.canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* 装饰性聊天消息：头像 + 气泡
   字号与微信默认一致（正文 27rpx / 名称 32rpx），透明度低，不干扰游戏 */
.msg {
  position: absolute;
  display: flex;
  align-items: flex-start;
  max-width: 420rpx;
  opacity: .62;
  pointer-events: none;
}
.msg.left { flex-direction: row; }
.msg.right { flex-direction: row-reverse; }

.msg-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  border: 1rpx solid var(--line-strong);
  background: #E5E5E5;
}

.msg-bubble {
  max-width: 300rpx;
  margin: 0 12rpx;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(0,0,0,0.06);
  font-size: 27rpx;          /* 与微信消息正文一致 */
  line-height: 1.45;
  color: #191919;
  word-break: break-all;
}
.msg.right .msg-bubble {
  background: rgba(149,236,105,0.55);   /* 己方绿色气泡 */
}

/* 老板键伪装层 */
.boss-layer {
  position: absolute;
  inset: 0;
  background: #EDEDED;
  z-index: 5;
}
.boss-tip {
  position: absolute;
  top: 40%; left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: #B2B2B2;
}

/* 中央提示 */
.hint {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 6;
}
.btn-start {
  min-width: 200rpx;
  height: 84rpx;
  padding: 0 48rpx;
  border-radius: 999rpx;
  background: var(--green);
  color: #FFFFFF;
  font-size: 32rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(7,193,96,0.28);
}
.hint-text { margin-top: 20rpx; font-size: 24rpx; color: var(--text-2); }

/* 红包飘字 */
.packet {
  position: absolute;
  left: 50%; top: 42%;
  transform: translate(-50%, -50%);
  color: #FA5151;
  font-size: 72rpx;
  font-weight: 700;
  text-shadow: 0 4rpx 16rpx rgba(250,81,81,0.35);
  animation: pop 1.2s ease-out;
  pointer-events: none;
  z-index: 7;
}
@keyframes pop {
  0%   { opacity: 0; transform: translate(-50%, -20%) scale(.6); }
  30%  { opacity: 1; transform: translate(-50%, -50%) scale(1.15); }
  100% { opacity: 0; transform: translate(-50%, -110%) scale(1); }
}

/* 轻提示 */
.toast {
  position: absolute;
  left: 50%; bottom: 40rpx;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.62);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  z-index: 8;
}

/* ---------- 底部操作栏：仅十字方向键 ---------- */
.actionbar {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 16rpx 24rpx 10rpx;
  background: #F7F7F7;
  border-top: 2rpx solid var(--line-strong);
  flex-shrink: 0;
}

/* 方向键区域：左右铺满整行 */
.pad { width: 100%; }

.pad-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.pad-row:last-child { margin-bottom: 0; }

.dbtn {
  width: 128rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--btn-border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
/* 同一行内按键之间保留间距（左右键与中间设置键） */
.pad-row .dbtn + .dbtn { margin-left: 20rpx; }

/* 中间设置键：与方向键同尺寸，样式略作区分 */
.dbtn.center { background: #F2F2F2; }
.center-text {
  font-size: 30rpx;
  color: #191919;
  font-weight: 500;
}
.dbtn-hover { background: #E2E2E2; }

/* 方向箭头（纯 CSS） */
.arw { width: 0; height: 0; border: 22rpx solid transparent; }
.arw.up    { border-bottom-color: #191919; margin-top: -12rpx; }
.arw.down  { border-top-color: #191919; margin-bottom: -12rpx; }
.arw.left  { border-right-color: #191919; margin-left: -12rpx; }
.arw.right { border-left-color: #191919; margin-right: -12rpx; }

/* 操作提示：居中，位于方向键下方 */
.bar-hint {
  text-align: center;
  font-size: 20rpx;
  color: #B2B2B2;
  margin-top: 6rpx;
}

/* ---------- 结算弹窗（伪装） ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 200;
}
.dialog {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}
.dlg-title {
  padding: 40rpx 32rpx 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.dlg-body {
  padding: 0 32rpx 36rpx;
  text-align: center;
  font-size: 27rpx;
  color: #4A4A4A;
  line-height: 1.7;
  white-space: pre-line;
}
.dlg-btns {
  display: flex;
  border-top: 1rpx solid var(--line);
}
.dlg-btn {
  flex: 1;
  height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
  color: var(--text);
}
.dlg-btn + .dlg-btn { border-left: 1rpx solid var(--line); }
.dlg-btn.primary { color: var(--green); font-weight: 600; }

.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
