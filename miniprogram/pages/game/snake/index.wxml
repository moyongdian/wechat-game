<!-- 游戏页：聊天贪吃蛇（伪装成聊天窗口） -->
<view class="page">

  <!-- 顶部：左上分数 / 中间聊天对象名称 / 右上设置 -->
  <view class="navbar" style="padding-top:{{statusBarHeight}}px">
    <view class="navbar-inner" style="height:{{navHeight}}px">
      <view class="nav-left">
        <view class="nav-back" bindtap="onBack" hover-class="nav-hover">
          <view class="ico-back"></view>
        </view>
        <view class="nav-score">
          <text class="nav-score-val">{{score}}</text>
        </view>
      </view>
      <view class="nav-title" bindtap="onTitleTap">
        <text class="ellipsis">{{chatName}}</text>
        <text class="nav-sub">{{modeLabel}}{{remainSeconds > 0 ? ' · ' + remainSeconds + 's' : ''}}</text>
      </view>
      <view class="nav-more" bindtap="onOpenSettings" hover-class="nav-hover">
        <view class="dot"></view><view class="dot"></view><view class="dot"></view>
      </view>
    </view>
  </view>
  <view style="height:{{statusBarHeight + navHeight}}px"></view>

  <!-- 消息区：游戏画布（底层） + 聊天消息流（滚动层） -->
  <view class="msg-area" style="{{bgStyle}}">
    <!-- 游戏画布：含黑色边框的墙 -->
    <canvas type="2d" id="gameCanvas" class="canvas"></canvas>

    <!-- 聊天消息流：新消息从下方出现并向上滚动 -->
    <scroll-view class="chat-scroll" scroll-y scroll-with-animation
                 scroll-into-view="{{scrollTo}}"
                 bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" bindtap="onMessageTap"
                 wx:if="{{!bossMode}}">
      <view class="chat-inner">
        <view class="msg {{item.self ? 'right' : 'left'}}"
              wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
          <image class="msg-avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view class="msg-bubble">
            <text>{{item.text}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 老板键伪装层：显示普通聊天内容 -->
    <scroll-view class="chat-scroll" scroll-y wx:if="{{bossMode}}">
      <view class="chat-inner">
        <view class="msg left">
          <image class="msg-avatar" src="/images/avatar-snake.png" mode="aspectFill" />
          <view class="msg-bubble"><text>这个我看一下</text></view>
        </view>
        <view class="msg right">
          <image class="msg-avatar" src="/images/avatar-me.png" mode="aspectFill" />
          <view class="msg-bubble"><text>好的，稍等</text></view>
        </view>
        <view class="msg left">
          <image class="msg-avatar" src="/images/avatar-snake.png" mode="aspectFill" />
          <view class="msg-bubble"><text>晚点回复你</text></view>
        </view>
        <view class="msg right">
          <image class="msg-avatar" src="/images/avatar-me.png" mode="aspectFill" />
          <view class="msg-bubble"><text>收到</text></view>
        </view>
      </view>
    </scroll-view>

    <!-- 未开始提示 -->
    <view class="hint" wx:if="{{!running && !paused && !over && !bossMode}}">
      <view class="btn-start" bindtap="onStart">开始</view>
      <text class="hint-text">方向键或滑动控制</text>
    </view>

    <!-- 暂停提示 -->
    <view class="hint" wx:if="{{paused && !over && !bossMode}}">
      <view class="btn-start" bindtap="onPauseToggle">继续</view>
      <text class="hint-text">已暂停</text>
    </view>

    <!-- 红包飘字 -->
    <view class="packet" wx:if="{{packetText}}">{{packetText}}</view>

    <!-- 轻提示 -->
    <view class="toast" wx:if="{{toastText}}">{{toastText}}</view>
  </view>

  <!-- 暂停时：底部换成仿微信聊天输入栏（点击可继续游戏） -->
  <view class="inputbar" wx:if="{{paused && !over}}" style="padding-bottom:{{safeBottom}}px"
        bindtap="onResumeFromBar">
    <view class="ib-row">
      <view class="ib-ico ib-voice">
        <view class="voice-arc"></view>
      </view>
      <view class="ib-input"><text class="ib-ph">发消息…</text></view>
      <view class="ib-ico ib-emoji">
        <view class="emoji-face"><view class="emoji-eye"></view><view class="emoji-eye"></view></view>
      </view>
      <view class="ib-ico ib-plus">
        <view class="plus-ring"></view>
      </view>
    </view>
    <text class="ib-hint">已暂停 · 点击任意位置继续</text>
  </view>

  <!-- 游戏中：底部十字方向键 + 中心设置 -->
  <view class="actionbar" wx:if="{{!paused || over}}" style="padding-bottom:{{safeBottom}}px">
    <view class="pad">
      <view class="pad-row">
        <view class="dbtn" data-dir="up" bindtap="onDir" hover-class="dbtn-hover">
          <view class="arw up"></view>
        </view>
      </view>
      <view class="pad-row">
        <view class="dbtn" data-dir="left" bindtap="onDir" hover-class="dbtn-hover">
          <view class="arw left"></view>
        </view>
        <view class="dbtn center" bindtap="onOpenSettings" hover-class="dbtn-hover">
          <text class="center-text">设置</text>
        </view>
        <view class="dbtn" data-dir="right" bindtap="onDir" hover-class="dbtn-hover">
          <view class="arw right"></view>
        </view>
      </view>
      <view class="pad-row">
        <view class="dbtn" data-dir="down" bindtap="onDir" hover-class="dbtn-hover">
          <view class="arw down"></view>
        </view>
      </view>
    </view>
    <text class="bar-hint">点消息区暂停 · 双击伪装</text>
  </view>

  <!-- 结算弹窗（伪装成消息发送失败） -->
  <view class="mask" wx:if="{{result.show}}">
    <view class="dialog">
      <view class="dlg-title">{{result.title}}</view>
      <view class="dlg-body">{{result.content}}</view>
      <view class="dlg-btns">
        <view class="dlg-btn" bindtap="onResend">重新发送</view>
        <view class="dlg-btn primary" bindtap="onBackToChat">返回聊天</view>
      </view>
    </view>
  </view>
</view>
