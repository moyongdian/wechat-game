<!-- 首页：类微信首页（原创类微信风格） -->
<view class="page">

  <!-- 顶部：状态栏 + 标题栏 -->
  <view class="navbar" style="padding-top:{{statusBarHeight}}px">
    <view class="navbar-inner" style="height:{{navHeight}}px">
      <view class="nav-title">聊天</view>
      <view class="nav-actions">
        <view class="nav-btn" bindtap="onSearch" hover-class="nav-btn-hover">
          <view class="ico-search"></view>
        </view>
        <view class="nav-btn" bindtap="onAdd" hover-class="nav-btn-hover">
          <view class="ico-plus"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 顶部占位 -->
  <view style="height:{{statusBarHeight + navHeight}}px"></view>

  <!-- 搜索框（伪装，点击提示开发中） -->
  <view class="search-wrap" bindtap="onSearch">
    <view class="search-box">
      <view class="ico-search grey"></view>
      <text class="search-ph">搜索</text>
    </view>
  </view>

  <!-- 聊天列表 -->
  <view class="chat-list">
    <view class="chat-item" wx:for="{{list}}" wx:key="id"
          data-item="{{item}}" bindtap="onTapItem" bindlongpress="onLongPressItem"
          hover-class="chat-item-hover">
      <view class="avatar-wrap">
        <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view class="badge" wx:if="{{item.unread > 0}}">{{item.unread}}</view>
      </view>
      <view class="chat-main">
        <view class="chat-row">
          <text class="chat-name ellipsis">{{item.name}}</text>
          <text class="chat-time">{{item.time}}</text>
        </view>
        <view class="chat-row">
          <text class="chat-msg ellipsis">{{item.msg}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部 Tab（仅“微信”可用，其余提示开发中） -->
  <view class="tabbar" style="padding-bottom:{{safeBottom}}px">
    <view class="tab-item {{activeTab === item.key ? 'active' : ''}}"
          wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onTab">
      <image class="tab-icon" src="{{item.icon}}" mode="aspectFit" wx:if="{{item.icon}}" />
      <view class="tab-icon tab-icon-wechat" wx:else>
        <view class="wk-dot"></view>
        <view class="wk-dot"></view>
      </view>
      <text class="tab-text">{{item.text}}</text>
      <view class="tab-badge" wx:if="{{item.key === 'wechat' && unreadTotal > 0}}">{{unreadTotal}}</view>
    </view>
  </view>
</view>
