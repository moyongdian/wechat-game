/* 首页：类微信首页（原创类微信风格） */
page {
  background: #EDEDED;
  --nav-bg: #EDEDED;
  --line: #E5E5E5;
  --text: #191919;
  --text-2: #888888;
  --green: #07C160;
}

/* ---------- 顶部栏 ---------- */
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: var(--nav-bg);
  border-bottom: 1rpx solid var(--line);
}
.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.nav-actions {
  position: absolute;
  right: 24rpx;
  display: flex;
  align-items: center;
}
.nav-btn {
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
}
.nav-btn-hover { opacity: .5; }

/* 纯 CSS 图标（原创，避免使用官方素材） */
.ico-search {
  width: 30rpx; height: 30rpx;
  border: 3rpx solid #191919;
  border-radius: 50%;
  position: relative;
}
.ico-search::after {
  content: '';
  position: absolute;
  right: -12rpx; bottom: -8rpx;
  width: 16rpx; height: 3rpx;
  background: #191919;
  transform: rotate(45deg);
  border-radius: 2rpx;
}
.ico-search.grey { border-color: #9A9A9A; }
.ico-search.grey::after { background: #9A9A9A; }

.ico-plus {
  width: 34rpx; height: 34rpx;
  position: relative;
}
.ico-plus::before, .ico-plus::after {
  content: '';
  position: absolute;
  background: #191919;
  border-radius: 2rpx;
}
.ico-plus::before { left: 0; top: 15rpx; width: 34rpx; height: 4rpx; }
.ico-plus::after  { top: 0; left: 15rpx; height: 34rpx; width: 4rpx; }

/* ---------- 搜索框 ---------- */
.search-wrap { padding: 16rpx 24rpx; background: #EDEDED; }
.search-box {
  height: 64rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.search-box .ico-search { width: 26rpx; height: 26rpx; border-width: 2rpx; margin-right: 12rpx; }
.search-box .ico-search::after { width: 12rpx; height: 2rpx; right: -9rpx; bottom: -6rpx; }
.search-ph { font-size: 28rpx; color: #9A9A9A; }

/* ---------- 聊天列表 ---------- */
.chat-list { background: #FFFFFF; }
.chat-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  position: relative;
}
.chat-item::after {
  content: '';
  position: absolute;
  left: 148rpx; right: 0; bottom: 0;
  height: 1rpx;
  background: var(--line);
}
.chat-item:last-child::after { display: none; }
.chat-item-hover { background: #E9E9E9; }

.avatar-wrap { position: relative; width: 96rpx; height: 96rpx; flex-shrink: 0; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 12rpx; background: #E5E5E5; }
.badge {
  position: absolute;
  top: -8rpx; right: -10rpx;
  min-width: 34rpx; height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #FA5151;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.chat-main { flex: 1; margin-left: 24rpx; min-width: 0; }
.chat-row { display: flex; align-items: center; justify-content: space-between; }
.chat-name {
  font-size: 32rpx;
  color: var(--text);
  max-width: 440rpx;
}
.chat-time { font-size: 24rpx; color: #B2B2B2; flex-shrink: 0; margin-left: 12rpx; }
.chat-msg {
  font-size: 27rpx;
  color: var(--text-2);
  margin-top: 10rpx;
  max-width: 520rpx;
  display: block;
}

/* ---------- 底部 Tab ---------- */
.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #F7F7F7;
  border-top: 1rpx solid var(--line);
  display: flex;
  z-index: 100;
}
.tab-item {
  flex: 1;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.tab-icon { width: 48rpx; height: 48rpx; }
.tab-icon-wechat {
  display: flex; align-items: center; justify-content: center;
  gap: 6rpx;
}
.wk-dot {
  width: 18rpx; height: 18rpx;
  border-radius: 50%;
  background: #7A7E83;
}
.tab-item.active .wk-dot { background: var(--green); }
.tab-text { font-size: 22rpx; color: #7A7E83; margin-top: 4rpx; }
.tab-item.active .tab-text { color: var(--green); }
.tab-badge {
  position: absolute;
  top: 8rpx; right: 50%;
  margin-right: -52rpx;
  min-width: 30rpx; height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #FA5151;
  color: #FFF;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

/* 底部留白，避免被 Tab 遮挡 */
.page { padding-bottom: 140rpx; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
