/* 设置页：仿聊天信息页 */
page {
  background: #EDEDED;
  --line: #E5E5E5;
  --text: #191919;
  --text-2: #888888;
  --green: #07C160;
  --red: #FA5151;
}

.navbar {
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 100;
  background: #F7F7F7;
  border-bottom: 1rpx solid var(--line);
}
.navbar-inner {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 20rpx;
}
.nav-back { width: 120rpx; height: 72rpx; display: flex; align-items: center; }
.ico-back {
  width: 22rpx; height: 22rpx;
  border-left: 4rpx solid #191919;
  border-bottom: 4rpx solid #191919;
  transform: rotate(45deg);
  border-radius: 2rpx;
}
.nav-title { font-size: 32rpx; font-weight: 600; color: var(--text); }
.nav-right { width: 120rpx; }
.nav-hover { opacity: .5; }

/* 分组 */
.group {
  background: #FFFFFF;
  margin-top: 20rpx;
  padding: 0 24rpx;
}
.group:first-of-type { margin-top: 20rpx; }

.row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--line);
  padding: 16rpx 0;
}
.row:last-child { border-bottom: none; }
.row.column { flex-direction: column; align-items: flex-start; }

.label { font-size: 30rpx; color: var(--text); }
.label.danger { color: var(--red); }
.value { font-size: 28rpx; color: var(--text-2); }
.arrow {
  width: 16rpx; height: 16rpx;
  border-top: 3rpx solid #C7C7C7;
  border-right: 3rpx solid #C7C7C7;
  transform: rotate(45deg);
  margin-left: 12rpx;
}
.tip { font-size: 22rpx; color: #B2B2B2; padding: 0 0 16rpx; line-height: 1.6; }

.input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: var(--text);
  margin-left: 24rpx;
}

/* 分段选择器 */
.seg {
  display: flex;
  margin-top: 16rpx;
  background: #F2F2F2;
  border-radius: 12rpx;
  padding: 4rpx;
  width: 100%;
}
.seg-item {
  flex: 1;
  height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx;
  color: var(--text-2);
  border-radius: 10rpx;
}
.seg-item.on { background: #FFFFFF; color: var(--green); font-weight: 600; }

/* 开关 */
.switch {
  width: 92rpx; height: 52rpx;
  border-radius: 999rpx;
  background: #DCDCDC;
  position: relative;
  transition: background .2s;
  flex-shrink: 0;
}
.switch.on { background: var(--green); }
.knob {
  position: absolute;
  top: 4rpx; left: 4rpx;
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
  transition: left .2s;
}
.switch.on .knob { left: 44rpx; }

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #B2B2B2;
  padding: 40rpx 0 60rpx;
}
